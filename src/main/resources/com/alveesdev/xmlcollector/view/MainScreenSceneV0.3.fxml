<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="500.0" maxWidth="785.0" prefHeight="500.0" prefWidth="785.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alveesdev.xmlcollector.view.MainScreenController">
   <children>
      <MenuBar prefHeight="25.0" prefWidth="709.0">
        <menus>
          <Menu mnemonicParsing="false" text="Arquivo">
            <items>
                  <MenuItem mnemonicParsing="false" text="Configurações" />
              <MenuItem mnemonicParsing="false" text="Sair" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ajuda">
            <items>
              <MenuItem mnemonicParsing="false" text="Sobre" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <TabPane prefHeight="501.0" prefWidth="785.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="NFCe">
               <content>
                  <VBox maxHeight="785.0" prefHeight="450.0" prefWidth="785.0">
                     <children>
                        <HBox minHeight="0.0" minWidth="0.0" prefHeight="0.0" prefWidth="785.0" VBox.vgrow="ALWAYS">
                           <children>
                              <RadioButton fx:id="RadioButtonColetaXMLCaminhoPDV" mnemonicParsing="false" text="Caminho PDV">
                                 <HBox.margin>
                                    <Insets left="30.0" top="20.0" />
                                 </HBox.margin>
                                 <toggleGroup>
                                    <ToggleGroup fx:id="DiretorioDeColeta" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="RadioButtonColetaXMLDiretorioUnico" mnemonicParsing="false" onAction="#initialize" text="Diretório Único" toggleGroup="$DiretorioDeColeta">
                                 <HBox.margin>
                                    <Insets left="-95.0" top="41.0" />
                                 </HBox.margin>
                              </RadioButton>
                              <TextField fx:id="txtDirectory" alignment="BOTTOM_LEFT" maxWidth="200.0" prefHeight="25.0" prefWidth="305.0" HBox.hgrow="NEVER">
                                 <HBox.margin>
                                    <Insets left="-105.0" top="65.0" />
                                 </HBox.margin>
                              </TextField>
                              <Button fx:id="btnVerificarDir" alignment="CENTER" mnemonicParsing="false" onAction="#onVerificarDiretorio" prefHeight="25.0" prefWidth="81.0" text="Coletar XML">
                                 <HBox.margin>
                                    <Insets left="20.0" top="65.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                        </HBox>
                        <TableView fx:id="tableView" minHeight="-Infinity" prefHeight="350.0" prefWidth="785.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="numberColumn" maxWidth="55.0" minWidth="55.0" prefWidth="55.0" text="NFCe" />
                            <TableColumn fx:id="serieColumn" maxWidth="55.0" minWidth="55.0" prefWidth="55.0" text="SERIE" />
                              <TableColumn fx:id="totalValueColumn" prefWidth="75.0" text="VALOR" />
                              <TableColumn fx:id="emissionDateColumn" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="DATA" />
                              <TableColumn fx:id="nfKeyColumn" maxWidth="360.0" minWidth="360.0" prefWidth="360.0" text="CHAVE" />
                              <TableColumn fx:id="statusColumn" maxWidth="112.666748046875" minWidth="40.0" prefWidth="102.666748046875" text="STATUS" />
                          </columns>
                           <VBox.margin>
                              <Insets top="100.0" />
                           </VBox.margin>
                        </TableView>
                     </children>
                  </VBox>
               </content>
          </Tab>
          <Tab text="Faltantes">
               <content>
                  <VBox maxHeight="785.0" prefHeight="450.0" prefWidth="785.0">
                     <children>
                        <HBox minHeight="0.0" minWidth="0.0" prefHeight="0.0" prefWidth="785.0" VBox.vgrow="ALWAYS" />
                        <TableView minHeight="-Infinity" prefHeight="350.0" prefWidth="785.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn prefWidth="75.0" text="PDV01" />
                            <TableColumn prefWidth="75.0" text="PDV02" />
                          </columns>
                           <VBox.margin>
                              <Insets top="100.0" />
                           </VBox.margin>
                        </TableView>
                     </children>
                  </VBox>
               </content>
          </Tab>
        </tabs>
      </TabPane>
      <Separator prefHeight="28.0" prefWidth="785.0">
         <VBox.margin>
            <Insets top="-10.0" />
         </VBox.margin>
      </Separator>
   </children>
</VBox>
