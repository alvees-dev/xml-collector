<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<HBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alveesdev.xmlcollector.ui.controller.DispatchTabController">
   <fx:define>
      <ToggleGroup fx:id="sourceGroup" />
   </fx:define>
   <children>
      <VBox minWidth="450.0" prefWidth="450.0" spacing="5.0">
         <padding>
            <Insets bottom="20.0" left="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Destinatário" />
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <TextField fx:id="txtRecipient" prefWidth="300.0" />
                  <Button fx:id="btnRecipientHelp" mnemonicParsing="false" onAction="#onRecipientHelp" maxHeight="25.0" maxWidth="26.0" minHeight="25.0" minWidth="26.0" prefHeight="25.0" prefWidth="26.0" style="-fx-padding: 0;">
                     <graphic>
                        <SVGPath content="M11,18h2v-2h-2V18z M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8s3.59-8,8-8s8,3.59,8,8S16.41,20,12,20z M12,6c-2.21,0-4,1.79-4,4h2c0-1.1,0.9-2,2-2s2,0.9,2,2c0,2-3,1.75-3,5h2c0-2.25,3-2.5,3-5C16,7.79,14.21,6,12,6z" styleClass="gear-icon" scaleX="0.75" scaleY="0.75" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="Como enviar para mais de um e-mail" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
            <Label text="Assunto">
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="txtSubject" maxWidth="300.0" />
            <Label text="Corpo do Email">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            <TextArea fx:id="txtBody" maxWidth="400.0" prefHeight="200.0" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
      <VBox spacing="5.0" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="50.0" right="20.0" top="40.0" />
         </padding>
         <children>
            <HBox spacing="30.0">
               <children>
                  <ChoiceBox fx:id="choiceYear" prefWidth="70.0" />
                  <ChoiceBox fx:id="choiceMonth" prefWidth="100.0" />
               </children>
            </HBox>
            <Label text="Relatórios">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Label>
            <!-- Gerar PDF on the right of the reports it prints. -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <CheckBox fx:id="chkValuesNfce" mnemonicParsing="false" selected="true" text="Valores NFCe" />
                        <CheckBox fx:id="chkValuesNfeSales" mnemonicParsing="false" text="Valores NFe Vendas" />
                        <CheckBox fx:id="chkValuesNfePurchases" mnemonicParsing="false" text="Valores NFe Compras" />
                     </children>
                  </VBox>
                  <Button fx:id="btnGeneratePdf" mnemonicParsing="false" onAction="#onGeneratePdf" text="Gerar PDF" />
               </children>
            </HBox>
            <Label text="Diretório de Envio">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Label>
            <RadioButton fx:id="radioCollectedSource" mnemonicParsing="false" selected="true" text="Diretório Coletado" toggleGroup="$sourceGroup">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </RadioButton>
            <RadioButton fx:id="radioServerSource" mnemonicParsing="false" text="Diretório Servidor" toggleGroup="$sourceGroup" />
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnCompress" mnemonicParsing="false" onAction="#onCompress" text="Apenas Compactar" />
                  <Button fx:id="btnSend" mnemonicParsing="false" styleClass="primary" onAction="#onSend" text="Enviar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
