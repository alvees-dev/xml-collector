<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alveesdev.xmlcollector.ui.controller.EmailTabController">
   <padding>
      <Insets left="25.0" top="40.0" />
   </padding>
   <children>
      <Label text="Email" />
      <TextField fx:id="txtEmailUser" maxWidth="200.0" />
      <Label text="Senha">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
      <PasswordField fx:id="txtEmailPassword" maxWidth="200.0" />
   </children>
</VBox>
