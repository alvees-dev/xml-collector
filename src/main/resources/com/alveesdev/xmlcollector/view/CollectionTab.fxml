<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alveesdev.xmlcollector.ui.controller.CollectionTabController">
   <fx:define>
      <ToggleGroup fx:id="sourceGroup" />
   </fx:define>
   <children>
      <HBox minHeight="100.0" prefHeight="100.0">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <padding>
                  <Insets left="22.0" right="20.0" />
               </padding>
               <children>
                  <Label text="Filtro de Data:" />
                  <DatePicker fx:id="dpFrom" prefWidth="110.0" promptText="De" />
                  <DatePicker fx:id="dpTo" prefWidth="110.0" promptText="Até" />
               </children>
            </VBox>
            <Separator orientation="VERTICAL" />
            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <padding>
                  <Insets left="20.0" right="25.0" />
               </padding>
               <children>
                  <RadioButton fx:id="radioPdvDirectories" mnemonicParsing="false" text="Diretório PDV" toggleGroup="$sourceGroup" />
                  <RadioButton fx:id="radioSingleDirectory" mnemonicParsing="false" text="Diretório Único" toggleGroup="$sourceGroup" />
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <TextField fx:id="txtDirectory" prefWidth="200.0" />
                        <Button fx:id="btnCollect" mnemonicParsing="false" onAction="#onCollect" prefWidth="81.0" text="Coletar XML" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Separator orientation="VERTICAL" />
            <VBox alignment="CENTER_LEFT" spacing="15.0">
               <padding>
                  <Insets left="8.0" right="10.0" />
               </padding>
               <children>
                  <CheckBox mnemonicParsing="false" text="NFe Vendas" />
                  <CheckBox mnemonicParsing="false" text="NFe Compras" />
               </children>
            </VBox>
            <Separator orientation="VERTICAL" />
            <GridPane alignment="CENTER_LEFT" hgap="8.0" vgap="6.0">
               <padding>
                  <Insets left="8.0" right="8.0" />
               </padding>
               <children>
                  <Label text="NFCe" />
                  <TextField editable="false" prefWidth="80.0" GridPane.columnIndex="1" />
                  <Label text="NFe V" GridPane.rowIndex="1" />
                  <TextField editable="false" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="NFe C" GridPane.rowIndex="2" />
                  <TextField editable="false" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
         </children>
      </HBox>
      <TableView fx:id="documentsTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="numberColumn" maxWidth="55.0" minWidth="55.0" prefWidth="55.0" text="NFCe" />
          <TableColumn fx:id="seriesColumn" maxWidth="55.0" minWidth="55.0" prefWidth="55.0" text="SERIE" />
          <TableColumn fx:id="totalValueColumn" prefWidth="75.0" text="VALOR" />
          <TableColumn fx:id="emissionDateColumn" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="DATA" />
          <TableColumn fx:id="accessKeyColumn" maxWidth="360.0" minWidth="360.0" prefWidth="360.0" text="CHAVE" />
          <TableColumn fx:id="statusColumn" maxWidth="113.0" minWidth="40.0" prefWidth="102.0" text="STATUS" />
        </columns>
      </TableView>
   </children>
</VBox>
