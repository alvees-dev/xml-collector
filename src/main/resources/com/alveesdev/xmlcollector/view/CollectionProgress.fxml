<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="540.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alveesdev.xmlcollector.ui.controller.ProgressController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="lblTitle" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="300.0" style="-fx-background-color: transparent; -fx-padding: 0;">
         <content>
            <VBox fx:id="sourcesBox" spacing="8.0">
               <padding>
                  <Insets bottom="4.0" right="4.0" top="4.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
      <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#onCancel" text="Cancelar" />
   </children>
</VBox>
