<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alveesdev.xmlcollector.ui.controller.MissingTabController">
   <children>
      <HBox minHeight="100.0" prefHeight="100.0">
         <children>
            <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Processo para todas as notas faltantes" />
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="btnSearchAll" mnemonicParsing="false" onAction="#onSearchAll" text="Procurar Todas" />
                        <Button mnemonicParsing="false" text="Inutilizar Todas" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Separator orientation="VERTICAL" />
            <VBox alignment="CENTER" spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Processo para uma nota específica" />
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="btnSearchNumber" mnemonicParsing="false" onAction="#onSearchNumber" text="Procurar NFCe" />
                        <TextField fx:id="txtSearchNumber" maxWidth="65.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" text="Inutilizar NFCe" />
                        <TextField maxWidth="65.0" />
                        <Label text="à" />
                        <TextField maxWidth="65.0" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <TableView fx:id="missingTable" VBox.vgrow="ALWAYS" />
   </children>
</VBox>
